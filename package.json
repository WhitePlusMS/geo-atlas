{
  "name": "dtc-2026-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data:checksums": "node scripts/update-checksums.mjs",
    "data:verify": "node scripts/verify-data.mjs",
    "map:check": "node --experimental-strip-types scripts/check-globe-layout.mjs",
    "pages:check": "node --experimental-strip-types scripts/check-spatial-layout.mjs",
    "predev": "npm run data:verify",
    "dev": "vite",
    "prebuild": "npm run data:verify",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "1.64.0",
    "papaparse": "^5.5.3",
    "pinia": "^3.0.3",
    "three": "^0.180.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.3.7",
    "vue-tsc": "^3.0.6"
  }
}
