  "open_system_model": {
    "scope": "依据公开赛题、联盟通用术语和公开国防白皮书发布说明，在第一级范围实现基地描述模型、GIS空间映射、聚合关系和来源版本线程。公开数据按快照更新并重新审核；没有接入测量、控制或实时态势，本成果不宣称完整动态孪生或专有模型接口认证。",
    "source_ids": [
      "public-level1-1497f5525783",
      "public-level1-045cba5473e9",
      "public-level1-c9471e733810"
    ],
    "concepts": [
      {
        "title": "关注实体与数字模型",
        "explanation": "先识别基地场址、组织和自然地理对象，再以属性与地图建立可核查的描述模型。",
        "implementation": "66个稳定site_id保留CRS原字段，canonical_name和有出处的描述作为派生属性；地点与驻地组织分层呈现。",
        "source_ids": [
          "public-level1-1497f5525783",
          "public-level1-045cba5473e9"
        ]
      },
      {
        "title": "实例与空间聚合",
        "explanation": "复合安装点包含多个具名地点；组成、管理、服务和邻接关系须保留语义。",
        "implementation": "16个复合对象使用components与稳定component_id，各成员有独立location；集合锚点不代替成员范围。",
        "source_ids": [
          "public-level1-045cba5473e9"
        ]
      },
      {
        "title": "数字线程与来源追溯",
        "explanation": "来源、字段、画像和GIS表达需要通过身份与版本关联，才能复核同一对象的信息。",
        "implementation": "source_id连接source_registry、field_evidence和description_sections；原始响应及文档SHA-256与生成结果相互绑定。",
        "source_ids": [
          "public-level1-045cba5473e9"
        ]
      },
      {
        "title": "时间、空间与目的视角",
        "explanation": "历史节点、设施尺度和一般用途是不同描述视角，不能互相替代。",
        "implementation": "三段画像保存历史日期与用途；空间证据明确Point/Polygon/MultiPolygon、对象范围及精度说明；岛屿、港区和街区不当作精确基地地籍。",
        "source_ids": [
          "public-level1-045cba5473e9"
        ]
      },
      {
        "title": "数据更新与审核闭环",
        "explanation": "公开快照更新后应重新核验身份、来源与空间匹配；旧审核不能替新内容背书。",
        "implementation": "五项输入版本和每条input_sha256绑定审核；章节、成员、坐标或原始来源变化会使审核失效，重建后由Codex逐项复审。",
        "source_ids": [
          "public-level1-1497f5525783",
          "public-level1-045cba5473e9"
        ]
      },
      {
        "title": "一级实现范围与扩展边界",
        "explanation": "当前实现描述与GIS可视化；测量同步、控制和可推演状态需要另外的可信输入与验证。",
        "implementation": "模型页面可选真实对象，展示JSON映射、设施地图、关系、来源链和版本。数据没有实时部署或传感器状态；保留独立模块与结构化接口便于以后扩展。",
        "source_ids": [
          "public-level1-1497f5525783",
          "public-level1-045cba5473e9",
          "public-level1-c9471e733810"
        ]
      }
    ]
  }
